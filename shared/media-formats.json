{
  "audio": {
    "wav":  { "input": "wav", "mux": "wav", "codec": "pcm_s16le" },
    "mp3":  { "input": "mp3", "mux": "mp3", "codec": "libmp3lame", "args": ["-q:a", "2"] },
    "flac": { "input": "flac", "mux": "flac", "codec": "flac" },
    "ogg":  { "input": "ogg", "mux": "ogg", "codec": "libvorbis", "args": ["-q:a", "5"] },
    "m4a":  { "input": "mov", "mux": "ipod", "codec": "aac", "args": ["-b:a", "192k"] },
    "aac":  { "input": "aac", "mux": "adts", "codec": "aac", "args": ["-b:a", "192k"] },
    "ac3":  { "input": "ac3", "mux": "ac3", "codec": "ac3", "args": ["-b:a", "256k", "-ar", "48000", "-ac", "2"] },
    "aifc": { "input": "aiff", "mux": "aiff", "codec": "pcm_s16le" },
    "aiff": { "aliases": ["aif"], "input": "aiff", "mux": "aiff", "codec": "pcm_s16be" },
    "amr":  { "input": "amr", "mux": "amr", "codec": "libopencore_amrnb", "args": ["-b:a", "12.2k", "-ar", "8000", "-ac", "1"] },
    "ast":  { "input": "ast", "mux": "ast", "codec": "pcm_s16be_planar" },
    "au":   { "aliases": ["snd"], "input": "au", "mux": "au", "codec": "pcm_s16be" },
    "caf":  { "input": "caf", "mux": "caf", "codec": "pcm_s16le" },
    "dts":  { "input": "dts", "mux": "dts", "codec": "dca", "args": ["-strict", "-2", "-b:a", "768k", "-ar", "48000", "-ac", "2"] },
    "eac3": { "input": "eac3", "mux": "eac3", "codec": "eac3", "args": ["-b:a", "256k", "-ar", "48000", "-ac", "2"] },
    "latm": { "aliases": ["loas"], "input": "loas", "mux": "latm", "codec": "aac", "args": ["-b:a", "192k"] },
    "m4b":  { "input": "mov", "mux": "ipod", "codec": "aac", "args": ["-b:a", "96k"] },
    "mka":  { "input": "matroska", "mux": "matroska", "codec": "flac" },
    "mp2":  { "input": "mp3", "mux": "mp2", "codec": "mp2", "args": ["-b:a", "192k", "-ar", "48000", "-ac", "2"] },
    "oga":  { "input": "ogg", "mux": "oga", "codec": "libvorbis", "args": ["-q:a", "5"] },
    "opus": { "input": "ogg", "mux": "opus", "codec": "libopus", "args": ["-b:a", "96k", "-ar", "48000"] },
    "sbc":  { "input": "sbc", "mux": "sbc", "codec": "sbc", "args": ["-ar", "48000", "-ac", "2"] },
    "spx":  { "input": "ogg", "decoder": "libspeex", "mux": "spx", "codec": "libspeex", "args": ["-ar", "16000", "-ac", "1"] },
    "tta":  { "input": "tta", "mux": "tta", "codec": "tta" },
    "voc":  { "input": "voc", "mux": "voc", "codec": "pcm_u8", "args": ["-ar", "22050", "-ac", "1"] },
    "wma":  { "input": "asf", "mux": "asf", "codec": "wmav2", "args": ["-b:a", "160k", "-ar", "44100", "-ac", "2"] },
    "wv":   { "input": "wv", "mux": "wv", "codec": "wavpack" }
  },
  "video": {
    "mp4":  { "input": "mov", "mux": "mp4", "preset": "avc", "args": ["-movflags", "+faststart"] },
    "webm": { "input": "matroska", "mux": "webm", "preset": "vp9" },
    "mov":  { "input": "mov", "mux": "mov", "preset": "avc" },
    "mkv":  { "input": "matroska", "mux": "matroska", "preset": "avc" },
    "3gp":  { "input": "mov", "mux": "3gp", "preset": "avc" },
    "3g2":  { "input": "mov", "mux": "3g2", "preset": "avc" },
    "avi":  { "input": "avi", "mux": "avi", "preset": "avi" },
    "dv":   { "input": "dv", "mux": "dv", "preset": "dv", "filter": "scale=720:576:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=720:576:(ow-iw)/2:(oh-ih)/2,setsar=16/15" },
    "f4v":  { "input": "mov", "mux": "f4v", "preset": "avc" },
    "flv":  { "input": "flv", "mux": "flv", "preset": "avc" },
    "ivf":  { "input": "ivf", "mux": "ivf", "preset": "vp9", "silent": true },
    "m4v":  { "input": ["mov", "m4v"], "mux": "mp4", "preset": "avc" },
    "mpg":  { "aliases": ["mpeg", "mpe"], "input": "mpeg", "mux": "mpeg", "preset": "mpeg1" },
    "mxf":  { "input": "mxf", "mux": "mxf", "preset": "mxf" },
    "nut":  { "input": "nut", "mux": "nut", "preset": "avc" },
    "ogv":  { "input": "ogg", "mux": "ogv", "preset": "theora" },
    "vob":  { "input": "mpeg", "mux": "vob", "preset": "mpeg2" },
    "wmv":  { "aliases": ["asf"], "input": "asf", "mux": "asf", "preset": "wmv" },
    "m1v":  { "input": "mpegvideo", "mux": "mpeg1video", "preset": "mpeg1", "silent": true },
    "m2v":  { "input": "mpegvideo", "mux": "mpeg2video", "preset": "mpeg2", "silent": true },
    "mjpeg": { "aliases": ["mjpg"], "input": "mjpeg", "mux": "mjpeg", "preset": "mjpeg", "silent": true },
    "h264": { "input": "h264", "mux": "h264", "preset": "avc", "silent": true },
    "h265": { "aliases": ["hevc"], "input": "hevc", "mux": "hevc", "preset": "hevc", "silent": true },
    "av1":  { "aliases": ["obu"], "input": "obu", "mux": "obu", "preset": "av1", "silent": true },
    "y4m":  { "input": "yuv4mpegpipe", "mux": "yuv4mpegpipe", "preset": "raw", "silent": true }
  }
}
